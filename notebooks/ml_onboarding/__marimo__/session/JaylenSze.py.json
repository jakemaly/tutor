      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">And let's run the trainer! The goal is to see the <code>reward</code> column increase. You might have to wait 150 to 200 steps for real progress, and you will probably see near-zero correctness reward for the first 100 steps. Please be patient!</span>\n<span class=\"paragraph\">The trainer is behind a button so that re-running or editing earlier cells never restarts the 250-step run by accident. The per-step logs are saved to a temp directory (outside the repo) and plotted below.</span></span>"
          }
        }
      ],
      "console": []
    },
