        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"train-the-model\">Train the model</h2>\n<span class=\"paragraph\"><a name=\"Train\"></a></span>\n<span class=\"paragraph\">Now set up GRPO Trainer and all configurations!</span></span>"
          }
        }
      ],
      "console": []
    },
    {
