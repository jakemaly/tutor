      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"before-training-baseline-generations\">Before training: baseline generations</h2>\n<span class=\"paragraph\">We generate from the base model (no LoRA) on a few fixed prompts: the upstream strawberry prompt with and without the format system prompt, plus three GSM8K <strong>test</strong> questions. The same prompts are re-run after training for a before/after comparison. This cell runs before training starts (the training cell depends on it).</span></span>"
          }
        }
      ],
      "console": []
    },
