# Vite uses this only for its local /api proxy; Compose overrides it for networking.
BACKEND_URL=http://127.0.0.1:8000

# OpenAI-compatible Chat Completions API base URL and model name.
# Leave these blank to run the UI and health check before connecting a model.
LLM_BASE_URL=
LLM_MODEL=

# Optional for endpoints that do not require authentication.
LLM_API_KEY=
